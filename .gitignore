# Generated by `flutter gen-l10n` from lib/l10n/app_*.arb on every `flutter pub get`.
# The .arb source files are committed; the generated Dart isn't.
/lib/l10n/generated/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# iOS and Linux scaffolds were removed — this is an Android-only project.
# Re-ignore the directories so a stray `flutter create .` doesn't resurrect them.
/ios/
/linux/

# Claude Code harness state (permission allowlist, session settings)
.claude/

